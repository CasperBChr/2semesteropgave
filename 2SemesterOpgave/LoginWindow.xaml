<Window x:Class="_2SemesterOpgave.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2SemesterOpgave"
        mc:Ignorable="d"
        Title="Login - RentWear" Height="750" Width="800">
	<Window.Resources>
    
    </Window.Resources>
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Image Source="/Assets/Asset_1.png" Grid.Row="0" Grid.Column="0" Margin="50"/>
		<Grid x:Name="GridPanel" Panel.ZIndex="2">
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="*" MinHeight="550" MaxHeight="800"/>
				<RowDefinition Height="auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" MinWidth="450" MaxWidth="700"/>
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Border x:Name="GridInputBorder" Grid.Row="1" Grid.Column="1" Panel.ZIndex="3">
				<ContentControl x:Name="LoginPageContentControl"/>
			</Border>
			<StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="20"  HorizontalAlignment="Center">
				<Button Visibility="Visible" Background="HotPink" Padding="20, 10" x:Name="ShowCreateAccountButton" Content="Opret Bruger" Click="ShowCreateAccountButton_Click" />
				<Button Visibility="Collapsed" Background="HotPink" Padding="20, 10"  x:Name="ShowLoginAccountButton" Content="Login med Bruger" Click="ShowLoginAccountButton_Click" />
			</StackPanel>
		</Grid>
	</Grid>
</Window>
