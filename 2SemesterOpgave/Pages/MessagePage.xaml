<UserControl x:Class="_2SemesterOpgave.Pages.MessagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<UserControl.Resources>
		<DataTemplate x:Key="UserParticipantTemplate">
			<Border BorderBrush="Gray" BorderThickness="1" Margin="5" CornerRadius="5" Height="40" Width="200">
				<Button Content="{Binding Username}" Cursor="Hand" FontWeight="Bold" FontSize="14" Background="LightGreen" BorderBrush="Transparent" BorderThickness="0" Click="UserButton_Click"/>
			</Border>
		</DataTemplate>
		<DataTemplate x:Key="MessageTemplate">
			<Border x:Name="Bubble" BorderBrush="Gray" BorderThickness="1" Margin="5" CornerRadius="5" Height="Auto" Background="{Binding Background}" HorizontalAlignment="{Binding Alignment}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Grid Grid.Row="0" Margin="10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="MessageSender" Grid.Column="0" Text="{Binding SenderName}" FontWeight="Bold" FontSize="14"/>
						<TextBlock x:Name="MessageTimeDate" Grid.Column="1" Text="{Binding Timestamp, StringFormat='HH:mm'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" />
					</Grid>
					<TextBlock Grid.Row="1" Margin="10" x:Name="MessageText" Text="{Binding Text}" FontWeight="Bold" FontSize="14"/>
				</Grid>
			</Border>
		</DataTemplate>
    </UserControl.Resources>

    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="50"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="50"/>
		</Grid.ColumnDefinitions>

		<Border Grid.Row="0" Grid.Column="1" BorderBrush="LightGray" CornerRadius="10" Margin="20" BorderThickness="1" MaxWidth="800">
			<StackPanel Orientation="Vertical">
				<Border>
					<TextBlock Text="Samtale med" Margin="20, 10, 0, 0" FontSize="16" />
				</Border>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
					<ItemsControl x:Name="ConversationParticipantsItemsControl" ItemsSource="{Binding OtherParticipants}" ItemTemplate="{StaticResource UserParticipantTemplate}" Margin="10">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"></WrapPanel>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
					</ItemsControl>
				</StackPanel>
			</StackPanel>
        </Border>

		<ScrollViewer Grid.Row="1" Grid.Column="1">
			<ItemsControl MaxWidth="800" x:Name="MessageItemsControl" ItemTemplate="{StaticResource MessageTemplate}" Margin="0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"></StackPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <Border MaxWidth="800" Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0, 20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="MessageTextBox" BorderThickness="0" FontSize="16" Grid.Column="0" Padding="10" VerticalAlignment="Center"/>
				<Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" CornerRadius="10" Margin="10, 0" Cursor="Hand">
					<Button Click="SendButton_Click" BorderBrush="Transparent" BorderThickness="0" Padding="20, 10" FontSize="20" Background="Transparent" Content="⬆️" />
				</Border>
            </Grid>
        </Border>
	</Grid>
</UserControl>
