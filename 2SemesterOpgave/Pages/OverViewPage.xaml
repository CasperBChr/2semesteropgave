<UserControl x:Class="_2SemesterOpgave.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <DataTemplate x:Key="ArticleTemplate">
            <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="5">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <!--<Image Source="{Binding ImageUrl}" Width="100" Height="100" Margin="5"/>-->
					<Button Click="ArticleButton_Click">
						<StackPanel Orientation="Vertical" Margin="5">
							<TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
							<TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="400"/>
						</StackPanel>
					</Button>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="200"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Column="0" Margin="10">
			<TextBlock Text="Farve" FontWeight="Bold" Margin="0,0,0,5"/>
			<ComboBox x:Name="ColorFilter" SelectionChanged="FilterChanged">
				<ComboBoxItem Content="Alle"/>
				<ComboBoxItem Content="Sort"/>
				<ComboBoxItem Content="Hvid"/>
				<ComboBoxItem Content="Rød"/>
			</ComboBox>

			<TextBlock Text="Størrelse" FontWeight="Bold" Margin="0,10,0,5"/>
			<ComboBox x:Name="SizeFilter" SelectionChanged="FilterChanged">
				<ComboBoxItem Content="Alle"/>
				<ComboBoxItem Content="XS"/>
				<ComboBoxItem Content="S"/>
				<ComboBoxItem Content="M"/>
				<ComboBoxItem Content="L"/>
				<ComboBoxItem Content="XL"/>
			</ComboBox>

			<TextBlock Text="Min pris" Foreground="Gray" FontSize="11"/>
			<TextBox x:Name="MinPriceBox" TextChanged="FilterChanged"/>

			<TextBlock Text="Max pris" Foreground="Gray" FontSize="11" Margin="0,5,0,0"/>
			<TextBox x:Name="MaxPriceBox" TextChanged="FilterChanged"/>
		</StackPanel>

		<ItemsControl Grid.Column="1" x:Name="ArticlesItemsControl" ItemTemplate="{StaticResource ArticleTemplate}" Margin="10"/>
	</Grid>


	<!--<Grid>
        --><!--<ListBox x:Name="ListBoxTest" DisplayMemberPath="Title" d:ItemsSource="{d:SampleData ItemCount=5}"/>--><!--
        <ItemsControl x:Name="ArticlesItemsControl" ItemTemplate="{StaticResource ArticleTemplate}" Margin="10"/>
    </Grid>-->

</UserControl>
