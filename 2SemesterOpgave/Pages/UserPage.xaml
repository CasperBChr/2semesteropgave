<UserControl x:Class="_2SemesterOpgave.Pages.UserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<UserControl.Resources>
		<DataTemplate x:Key="ArticleTemplate">
			<Border BorderBrush="Gray" BorderThickness="1" Width="200" Margin="5" CornerRadius="5" >
				<Button x:Name="ArticlePageButton" Click="ArticlePageButton_Click" Background="Transparent" >
					<StackPanel Orientation="Vertical" Margin="5">
						<Image Source="{Binding ImageUrl}" Width="100" Height="100" Margin="5"/>
						<StackPanel Orientation="Vertical" Margin="5">
							<Image Source="{Binding ImageUrl}" Width="100" Height="100" Margin="5"/>
							<StackPanel Orientation="Vertical" Margin="5">
								<TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
								<TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="400"/>
								<TextBlock Text="{Binding Brand.Name}" FontWeight="Bold" FontSize="12"/>
								<TextBlock Text="{Binding Size.Name}" FontWeight="Bold" FontSize="12"/>
								<TextBlock Text="{Binding Category.Name}" FontWeight="Bold" FontSize="12"/>
								<TextBlock Text="{Binding Color}" FontWeight="Bold" FontSize="12"/>
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="Price: "/>
									<TextBlock Text="{Binding DailyPrice}" />
								</StackPanel>
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</Button>
			</Border>
		</DataTemplate>
	</UserControl.Resources>

	<ScrollViewer>

		<Grid HorizontalAlignment="Center" VerticalAlignment="Center">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" MinHeight="500"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<Grid MaxWidth="800">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<Border Height="300" CornerRadius="110" ClipToBounds="True" Background="#FFEFEFEF" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="120,0,0,0" >
					<Image Source="/Assets/Articles/UserPlaceholder.jpg" Stretch="UniformToFill" />
				</Border>

				<Grid Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="auto"/>
					</Grid.RowDefinitions>
					<TextBlock Text="{Binding Username}" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0, 10" FontSize="40"/>
					<StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="0, 10">
						<TextBlock Text="Lokation:" Width="120" FontWeight="SemiBold" FontSize="20"/>
						<TextBlock Text="{Binding City}" FontWeight="SemiBold" FontSize="20" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0, 10" Grid.Row="2" Grid.Column="0">
						<TextBlock Text="Rating:" FontWeight="SemiBold" Width="120" VerticalAlignment="Center" FontSize="20"/>
						<TextBlock Text="{Binding RatingScore, StringFormat={}{0:0.0}}" VerticalAlignment="Center" FontSize="20" />
						<TextBlock Text="★" Foreground="Gold" FontSize="32" VerticalAlignment="Center" Margin="10, 0, 0, 5" />
					</StackPanel>
					<StackPanel Grid.Row="3" Grid.Column="0">
						<Button Content="Vurdér bruger" Width="140" Height="32" Cursor="Hand" BorderThickness="0" Background="Gold" HorizontalAlignment="Left" Click="ReviewUserButton_Click" />
					</StackPanel>
					<StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0, 50">
						<StackPanel Orientation="Horizontal" Margin="0">
							<TextBlock Text="Følgere:  " FontWeight="SemiBold" FontSize="20" />
							<TextBlock Text="{Binding FollowersCount}" FontWeight="SemiBold" FontSize="20" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="50, 0, 0, 0">
							<TextBlock Text="Følger:  " FontWeight="SemiBold" FontSize="20" />
							<TextBlock Text="{Binding FollowingCount}" FontWeight="SemiBold" FontSize="20" />
						</StackPanel>
					</StackPanel>
				</Grid>
			</Grid>
			<ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ArticlesItemsControl" ItemTemplate="{StaticResource ArticleTemplate}" Margin="10">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"></WrapPanel>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</Grid>
	</ScrollViewer>
</UserControl>