<UserControl x:Class="_2SemesterOpgave.Pages.UserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DataTemplate x:Key="ArticleTemplate">
            <Border BorderBrush="Gray" BorderThickness="1" Width="200" Margin="5" CornerRadius="5" >
                <Button x:Name="ArticlePageButton" Click="ArticlePageButton_Click" Background="Transparent" >
                    <StackPanel Orientation="Vertical" Margin="5">
                        <Image Source="{Binding ImageUrl}" Width="100" Height="100" Margin="5"/>
                        <StackPanel Orientation="Vertical" Margin="5">
                            <Image Source="{Binding ImageUrl}" Width="100" Height="100" Margin="5"/>
                            <StackPanel Orientation="Vertical" Margin="5">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="400"/>
                                <TextBlock Text="{Binding Brand.Name}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding Size.Name}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding Category.Name}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding Color}" FontWeight="Bold" FontSize="12"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Price: "/>
                                    <TextBlock Text="{Binding DailyPrice}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/> 
                <RowDefinition Height="*"/> 
            </Grid.RowDefinitions>
            <Grid MaxWidth="600">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Height="220" CornerRadius="110" ClipToBounds="True" Background="#FFEFEFEF" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="120,0,0,0" >
                    <Image Source="{Binding ProfilePicture}" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="TextBlockUsername" Text="User Page" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,90,50" />
                    <!--<TextBox Text="{Binding City.Name}" />-->
                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="20" Height="30" Margin="0,5,0,15" />
                    <TextBlock Text="{Binding City}" FontWeight="SemiBold" FontSize="20" Height="30" Margin="0,5,0,15" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <!-- Gul stjerne + rating med 1 decimal (f.eks. 5.0, 4.7, 2.3) -->
                        <TextBlock Text="★" Foreground="Gold" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="Rating:" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RatingScore, StringFormat={}{0:0.0}}" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Følgere:" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FollowersCount}" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Følger:" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FollowingCount}" Margin="6,0,0,0" />
                    </StackPanel>

                </StackPanel>

            </Grid>
            <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ArticlesItemsControl" ItemTemplate="{StaticResource ArticleTemplate}" Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"></WrapPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

        </Grid>
    </ScrollViewer>
</UserControl>
