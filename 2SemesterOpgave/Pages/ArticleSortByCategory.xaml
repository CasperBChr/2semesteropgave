<UserControl x:Class="_2SemesterOpgave.Pages.ArticleSortByCategory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <DataTemplate x:Key="ArticleTemplate">
            <Button Click="ArticleCategoryPageButton_Click" >
                <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="5">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <!--<Image Source="{Binding ImageUrl}" Width="100" Height="100" Margin="5"/>-->
                        <StackPanel Orientation="Vertical" Margin="5">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="400"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="CategoryNameTextBlock" Grid.Row="0" FontWeight="Bold" FontSize="16" Margin="10"/>
        <ItemsControl x:Name="ArticlesItemsControl" Grid.Row="1" ItemTemplate="{StaticResource ArticleTemplate}" Margin="10"/>
    </Grid>
</UserControl>
