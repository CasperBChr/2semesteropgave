<UserControl x:Class="_2SemesterOpgave.Pages.ArticleSortByCategory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <DataTemplate x:Key="ArticleTemplate">
            <Border BorderBrush="Gray" BorderThickness="1" Width="200" Margin="5" CornerRadius="5" Cursor="Hand" >
                <Button Click="ArticleCategoryPageButton_Click" Background="Transparent">
                    <StackPanel Orientation="Vertical" Margin="5">
                        <Image Source="{Binding ImageUrl}" Width="100" Height="100" Margin="5"/>
                        <StackPanel Orientation="Vertical" Margin="5">
                            <Image Source="{Binding ImageUrl}" Width="100" Height="100" Margin="5"/>
                            <StackPanel Orientation="Vertical" Margin="5">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="400"/>
                                <TextBlock Text="{Binding Brand.Name}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding Size.Name}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding Category.Name}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding Color}" FontWeight="Bold" FontSize="12"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Price: "/>
                                    <TextBlock Text="{Binding DailyPrice}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <Grid Margin="50, 50">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="600" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0, 25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CategoryNameTextBlock" Grid.Row="0" FontWeight="Bold" FontSize="16" Margin="10"/>                
                
                <ItemsControl Grid.Row="1" Grid.Column="0" x:Name="ArticlesItemsControl" ItemTemplate="{StaticResource ArticleTemplate}" Margin="10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"></WrapPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Grid>
    </ScrollViewer>
    
</UserControl>
