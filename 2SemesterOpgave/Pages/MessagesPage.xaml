<UserControl x:Class="_2SemesterOpgave.Pages.MessagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<UserControl.Resources>
		<Style x:Key="ConversationItemButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Padding" Value="12,10"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="LightGray" BorderThickness="1" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<DataTemplate x:Key="ConversationListTemplate">
			<Button Width="260" Click="ConversationButton_Click" Tag="{Binding}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource ConversationItemButton}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsUnread}" Value="True">
								<Setter Property="FontWeight" Value="Bold"/>
								<Setter Property="Background" Value="LightPink"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<Border Width="40" Height="40" CornerRadius="15" Background="HotPink" Margin="0,0,10,0" BorderThickness="0">
						<TextBlock Text="{Binding DisplayInitial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="White"/>
					</Border>

					<StackPanel VerticalAlignment="Center" MaxWidth="180">
						<TextBlock Text="{Binding ParticipantNames}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
						<TextBlock Text="{Binding LastMessagePreview}" FontSize="12" Foreground="Gray" TextTrimming="CharacterEllipsis" Margin="5"/>
					</StackPanel>
				</StackPanel>
			</Button>
		</DataTemplate>
	</UserControl.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="280"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0" Background="White" BorderBrush="LightGray" BorderThickness="1">
			<DockPanel>
				<Border DockPanel.Dock="Top" Background="White" Padding="20">
					<TextBlock Text="Beskeder" FontSize="18" FontWeight="Bold"/>
				</Border>

				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<ItemsControl x:Name="ConversationListControl" ItemTemplate="{StaticResource ConversationListTemplate}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Vertical"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
					</ItemsControl>
				</ScrollViewer>
			</DockPanel>
		</Border>

		<Grid Grid.Column="1">
			<Border x:Name="EmptyConversationView" Background="White">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock Text="Vælg en samtale for at åbne den" FontSize="20" HorizontalAlignment="Center"/>
				</StackPanel>
			</Border>

			<ContentControl x:Name="ConversationContent"/>
		</Grid>
	</Grid>
</UserControl>
