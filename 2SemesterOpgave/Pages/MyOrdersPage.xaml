<UserControl x:Class="_2SemesterOpgave.Pages.MyOrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
			<StackPanel Margin="24">
				<Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

						<StackPanel>
							<TextBlock Text="MINE ORDRE" Foreground="#3B5BFF" FontWeight="SemiBold" />
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="Lejeaftaler for " FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
								<TextBlock Text="{Binding CurrentUser.Username}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
							</StackPanel>
						</StackPanel>
					</Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Rentals}" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>

									<Border Width="96" Height="96" CornerRadius="8" Background="#F3F4F6" VerticalAlignment="Top">
										<Image Source="/Assets/Articles/ArticlePlaceholder.jpg" Stretch="UniformToFill"/>
									</Border>
									<StackPanel Grid.Column="1" Margin="12,0,12,0">
                                        <Border Background="#E8FFF1" BorderBrush="#B7F0CE" BorderThickness="1" CornerRadius="12" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="Bekræftet" Foreground="#1F7A4D" FontWeight="SemiBold" FontSize="12" />
                                        </Border>

                                        <TextBlock Text="{Binding Article.Title}" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,2" />
                                        <TextBlock Text="{Binding Article.Description}" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,2" />
										<TextBlock>
                                            <Run Text="{Binding Article.Brand.Name}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Rentee.Username}" />
										</TextBlock>

										<TextBlock Margin="0,4,0,0">
                                            <Run Text="{Binding StartDate, StringFormat={}{0:dd. MMM yyyy}}" />
                                            <Run Text=" - " />
                                            <Run Text="{Binding EndDate, StringFormat={}{0:dd. MMM yyyy}}" />
                                        </TextBlock>

                                        <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:0} kr.}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <Button x:Name="ArticlePageButton" Cursor="Hand" Content="Se artikel" Width="120" Height="32" Margin="0,0,0,6" Click="ArticlePageButton_Click" />
										<Button Content="Annullér" Cursor="Hand" Width="120" Height="32" Margin="0,0,0,6" Foreground="#C0392B" />
										<Button Content="Vurdér" Cursor="Hand" Width="120" Height="32" Click="ReviewButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


				<Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="20">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<StackPanel>
							<TextBlock Text="MINE ORDRE" Foreground="#3B5BFF" FontWeight="SemiBold" />
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="Udlejet af " FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
								<TextBlock Text="{Binding CurrentUser.Username}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
							</StackPanel>
						</StackPanel>
					</Grid>
				</Border>

				<ItemsControl ItemsSource="{Binding RentedOut}" Margin="0,16,0,0">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="140" />
									</Grid.ColumnDefinitions>
									<Border Width="96" Height="96" CornerRadius="8" Background="#F3F4F6" VerticalAlignment="Top">
										<Image Source="/Assets/Articles/ArticlePlaceholder.jpg" Stretch="UniformToFill"/>
									</Border>


									<StackPanel Grid.Column="1" Margin="12,0,12,0">
										<Border Background="#E8FFF1" BorderBrush="#B7F0CE" BorderThickness="1" CornerRadius="12" Padding="6,2" HorizontalAlignment="Left">
											<TextBlock Text="Bekræftet" Foreground="#1F7A4D" FontWeight="SemiBold" FontSize="12" />
										</Border>

										<TextBlock Text="{Binding Article.Title}" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,2" />
										<TextBlock Text="{Binding Article.Description}" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,2" />
										<TextBlock>
                                            <Run Text="{Binding Article.Brand.Name}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Rentee.Username}" />
										</TextBlock>

										<TextBlock Margin="0,4,0,0">
                                            <Run Text="{Binding StartDate, StringFormat={}{0:dd. MMM yyyy}}" />
                                            <Run Text=" - " />
                                            <Run Text="{Binding EndDate, StringFormat={}{0:dd. MMM yyyy}}" />
										</TextBlock>

										<TextBlock Text="{Binding TotalPrice, StringFormat={}{0:0} kr.}" FontWeight="SemiBold" Margin="0,4,0,0" />
									</StackPanel>

									<StackPanel Grid.Column="2" HorizontalAlignment="Right">
										<Button Content="Se artikel" Width="120" Height="32" Margin="0,0,0,6" />
										<Button Content="Annullér" Width="120" Height="32" Margin="0,0,0,6" Foreground="#C0392B" />
										<Button Content="Vurdér" Width="120" Height="32" Click="ReviewButton_Click" />
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
