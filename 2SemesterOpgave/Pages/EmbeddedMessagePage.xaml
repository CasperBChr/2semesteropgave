<UserControl x:Class="_2SemesterOpgave.Pages.EmbeddedMessagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<UserControl.Resources>
		<DataTemplate x:Key="MessageTemplate">
			<Grid Margin="6,3">
				<Border HorizontalAlignment="{Binding Alignment}" Background="{Binding Background}" CornerRadius="12" Padding="10,7" MaxWidth="380">
					<StackPanel>
						<TextBlock Text="{Binding SenderName}" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,2">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Alignment}" Value="Right">
											<Setter Property="Visibility" Value="Collapsed"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
						<TextBlock Text="{Binding Text}" FontSize="13" Foreground="#222" TextWrapping="Wrap"/>
						<TextBlock Text="{Binding Timestamp, StringFormat=HH:mm}" FontSize="10" Foreground="#888" HorizontalAlignment="Right" Margin="0,3,0,0"/>
					</StackPanel>
				</Border>
			</Grid>
		</DataTemplate>
	</UserControl.Resources>

	<Grid Background="White">
		<Grid.RowDefinitions>
			<RowDefinition Height="56"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="White" BorderBrush="Gray" Padding="16,0">
			<TextBlock x:Name="ParticipantsHeader" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
		</Border>

		<ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<ItemsControl x:Name="MessagesItemsControl" ItemTemplate="{StaticResource MessageTemplate}" Padding="10"/>
		</ScrollViewer>

		<Border Grid.Row="2" Background="White" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="12,8">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<TextBox x:Name="MessageInputBox" Grid.Column="0" Padding="10, 5" FontSize="16" VerticalContentAlignment="Center" BorderBrush="Gray" BorderThickness="1" TextWrapping="Wrap" MaxHeight="80" KeyDown="MessageInputBox_KeyDown"/>

				<Button Grid.Column="1" Content="Send" Margin="20, 10" Padding="20,10" FontSize="14" FontWeight="SemiBold" Background="HotPink" Foreground="White" BorderThickness="0" Cursor="Hand" Click="SendButton_Click" />
			</Grid>
		</Border>
	</Grid>
</UserControl>
