<UserControl x:Class="_2SemesterOpgave.Pages.ReviewsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
			<StackPanel Margin="24">
				<Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

						<StackPanel Orientation="Horizontal">
							<TextBlock Text="{Binding TargetUser.Username}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
							<TextBlock Text=" reviews" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="#EEF2FF" VerticalAlignment="Top">
                            <TextBlock Text="⭐" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                        </Border>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="Anmeldelser om " FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding TargetUser.Username}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ReviewsAboutMe}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
												<TextBlock Text="★" Foreground="Gold" Margin="0,0,6,0" FontSize="14" VerticalAlignment="Center"/>
												<TextBlock Text="{Binding Rating}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
												<Button Content="{Binding ReviewerUsername}" Click="ReviewerButton_Click" Padding="10, 5" Margin="20, 0" Background="LightGoldenrodYellow" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Comment}" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd. MMM yyyy}}" Foreground="#6B7280" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="{Binding TargetUser.Username}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="'s anmeldelser" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ReviewsByMe}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
											<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
												<TextBlock Text="★" Foreground="Gold" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
												<TextBlock Text="{Binding Rating}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
												<Button Content="{Binding RevieweeUsername}" Click="RevieweeButton_Click" Padding="10, 5" Margin="20, 0" Background="LightGoldenrodYellow" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Comment}" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd. MMM yyyy}}" Foreground="#6B7280" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

				<Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,16,0,0">
					<StackPanel>
						<TextBlock Text="Giv en anmeldelse" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

						<TextBlock Text="Rental ID (valgfri)" FontWeight="SemiBold" />
                        <TextBlock x:Name="RentalIdTextBlock" Margin="0, 10" />

						<TextBlock Text="Rating (1-5)" FontWeight="SemiBold" />
						<ComboBox x:Name="RatingComboBox" Margin="0,4,0,12" Width="100" HorizontalAlignment="Left">
							<ComboBoxItem Content="1" />
							<ComboBoxItem Content="2" />
							<ComboBoxItem Content="3" />
							<ComboBoxItem Content="4" />
							<ComboBoxItem Content="5" />
						</ComboBox>

						<TextBlock Text="Kommentar" FontWeight="SemiBold" />
                        <TextBox x:Name="CommentTextBox" Margin="0,4,0,12" Height="80" TextWrapping="Wrap" AcceptsReturn="True" />

                        <Button x:Name="SaveReviewButton" Content="Gem anmeldelse" Width="160" Height="32" HorizontalAlignment="Left" Click="CreateReviewButton_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>