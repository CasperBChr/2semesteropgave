<UserControl x:Class="_2SemesterOpgave.Pages.ArticlePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <!--<ItemsControl x:Name="articleItemsControl">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"></WrapPanel>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>-->

        <Image HorizontalAlignment="Center"  Margin="10,10,0,0" VerticalAlignment="Center" Grid.Column="0"/>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
               
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleTextBox" FontSize="40" Grid.Row="0" Text="{Binding Title}"><LineBreak/></TextBlock>
            <TextBlock x:Name="DescriptionTextBox" FontSize="40" Grid.Row="1" Text="{Binding Description}"/>
            <StackPanel Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Kategori: " FontSize="15" />
                    <ListBox x:Name="categoryTextBlock" FontSize="15" ItemsSource="{Binding Categories}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Under kategori: " FontSize="15" />
                    <ListBox x:Name="subcategoryTextBlock" FontSize="15" ItemsSource="{Binding Subcategories}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Størrelse: " FontSize="15" />
                    <TextBlock x:Name="sizeTextBlock" FontSize="15" Text="{Binding Size.ClothingUSSize}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Pris: " FontSize="15" />
                    <TextBlock x:Name="priceTextBlock" FontSize="15" Text="{Binding DailyPrice}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Farve: " FontSize="15" />
                    <TextBlock x:Name="colorTextBlock" FontSize="15" Text="{Binding Color}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Brand: " FontSize="15" />
                    <TextBlock x:Name="brandTextBlock" FontSize="15" Text="{Binding Brand.Name}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                
                <Button x:Name="ContactButton" Content="Kontakt" FontWeight="Bold" FontSize="14" Background="HotPink" BorderBrush="Transparent" BorderThickness="0" Margin="20" Padding="20,10" Click="ContactButton_Click"/>
                <Button Content="Lej" FontWeight="Bold" FontSize="14" Background="HotPink" BorderBrush="Transparent" BorderThickness="0" Margin="20" Padding="20,10"/>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
