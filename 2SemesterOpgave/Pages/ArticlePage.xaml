<UserControl x:Class="_2SemesterOpgave.Pages.ArticlePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <!--<ItemsControl x:Name="articleItemsControl">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"></WrapPanel>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>-->

        <Image HorizontalAlignment="Center"  Margin="10,10,0,0" VerticalAlignment="Center" Grid.Column="0"/>
        
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
               
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleTextBox" FontSize="40" Grid.Row="0" Margin="10" Text="{Binding Title}" ><LineBreak/></TextBlock>
            <TextBlock x:Name="DescriptionTextBox" FontSize="20" Grid.Row="1" Margin="10, 0, 10, 30" Text="{Binding Description}"/>
            <StackPanel Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Kategori: " FontSize="15" Margin="5, 10, 49, 10"/>
                    <ListBox x:Name="CategoryTextBlock" FontSize="15" ItemsSource="{Binding Categories}" Margin="0, 5, 0, 5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Under kategori: " FontSize="15" Margin="5, 10, 5, 10"/>
                    <ListBox x:Name="SubcategoryTextBlock" FontSize="15" ItemsSource="{Binding Subcategories}" Margin="0, 5, 0, 5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Størrelse: " FontSize="15" Margin="5, 10, 42, 10"/>
                    <TextBlock x:Name="SizeTextBlock" FontSize="15" Text="{Binding Size.ClothingUSSize}" Margin="0, 10, 0, 5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Pris: " FontSize="15" Margin="5, 10, 80, 10"/>
                    <TextBlock x:Name="PriceTextBlock" FontSize="15" Text="{Binding DailyPrice}" Margin="0, 5, 0, 5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Farve: " FontSize="15" Margin="5, 10, 50, 10"/>
                    <TextBlock x:Name="ColorTextBlock" FontSize="15" Text="{Binding Color}" Margin="0, 5, 0, 5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Brand: " FontSize="15" Margin="5, 10, 50, 10"/>
                    <TextBlock x:Name="BrandTextBlock" FontSize="15" Text="{Binding Brand.Name}" Margin="0, 5, 0, 5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Udlejer: " FontSize="15" Margin="5, 10, 50, 10"/>
                    <TextBlock x:Name="OwnerTextBlock" FontSize="15" Text="{Binding Owner.Username}" Margin="0, 5, 0, 5"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                
                <Button x:Name="ContactButton" Content="Kontakt" FontWeight="Bold" FontSize="14" Background="HotPink" BorderBrush="Transparent" BorderThickness="0" Margin="20" Padding="20,10" Click="ContactButton_Click"/>
                <Button x:Name="RentButton"  Content="Lej" FontWeight="Bold" FontSize="14" Background="HotPink" BorderBrush="Transparent" BorderThickness="0" Margin="20" Padding="20,10" Click="Button_Click"/>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
