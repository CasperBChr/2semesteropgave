<UserControl x:Class="_2SemesterOpgave.Pages.ArticlePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Column="0">
			<Border MaxHeight="600" MaxWidth="600" BorderBrush="Black" BorderThickness="1" Margin="40">
				<Image Source="/Assets/Articles/ArticlePlaceholder.jpg" HorizontalAlignment="Center" Margin="10" VerticalAlignment="Top"/>
			</Border>
		</StackPanel>
        
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
               
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleTextBox" FontSize="40"  Text="{Binding Title}" ><LineBreak/></TextBlock>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DescriptionTextBox" Grid.ColumnSpan="2" FontSize="20" Text="{Binding Description}"/>
            </Grid>

            <StackPanel Grid.Row="2" Grid.Column="0">
           
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Kategori: " FontSize="15" Grid.Row="0" Grid.Column="0"/>
                    <TextBlock x:Name="CategoryTextBlock" FontSize="15" Text="{Binding Category.Name}" Margin="0,0,20,0" Grid.Row="0" Grid.Column="1"/>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Under kategori: " FontSize="15" Grid.Row="0" Grid.Column="0"/>
                    <TextBlock x:Name="SubcategoryTextBlock" FontSize="15" Text="{Binding SubCategory.Name}" Margin="0,0,20,0" Grid.Row="0" Grid.Column="1"/>
                </Grid>


                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Størrelse: " FontSize="15" Grid.Row="0" Grid.Column="0"/>
                    <TextBlock x:Name="SizeTextBlock" FontSize="15" Text="{Binding Size.Name}" Margin="0,0,20,0" Grid.Row="0" Grid.Column="1"/>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Pris: " FontSize="15" Grid.Row="0" Grid.Column="0"/>
                    <TextBlock x:Name="PriceTextBlock" FontSize="15" Text="{Binding DailyPrice}" Margin="0,0,20,0" Grid.Row="0" Grid.Column="1"/>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Farve: " FontSize="15" Grid.Row="0" Grid.Column="0"/>
                    <TextBlock x:Name="ColorTextBlock" FontSize="15" Text="{Binding Color.Name}" Margin="0,0,20,0" Grid.Row="0" Grid.Column="1"/>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Brand: " FontSize="15" Grid.Row="0" Grid.Column="0"/>
                    <TextBlock x:Name="BrandTextBlock" FontSize="15" Text="{Binding Brand.Name}" Margin="0,0,20,0" Grid.Row="0" Grid.Column="1"/>
                </Grid>

				<Grid Margin="0,10,0,0" VerticalAlignment="Center">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="170" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="Udlejer: " FontSize="15" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
					<Button x:Name="OwnerProfileButton" FontSize="15" Content="{Binding Owner.Username}" Cursor="Hand" Background="LightSkyBlue" BorderThickness="0" HorizontalAlignment="Left"  Padding="30, 10" Grid.Row="0" Grid.Column="1" Click="OwnerProfileButton_Click"/>
				</Grid>
			</StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
				<Button x:Name="FavoriteButton" Content="🤍" FontSize="20" FontWeight="Bold" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="20" Click="FavoriteButton_Click"/>
				<Button x:Name="ContactButton" Content="Kontakt" FontWeight="Bold" FontSize="14" Background="HotPink" BorderBrush="Transparent" BorderThickness="0" Margin="20" Padding="20,10" Click="ContactButton_Click"/>
                <Button x:Name="RentButton"  Content="Lej" FontWeight="Bold" FontSize="14" Background="HotPink" BorderBrush="Transparent" BorderThickness="0" Margin="20" Padding="20,10" Click="Button_Click"/>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
