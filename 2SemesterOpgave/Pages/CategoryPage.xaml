<UserControl x:Class="_2SemesterOpgave.Pages.CategoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <DataTemplate x:Key="CategoryTemplate">
            <Border BorderBrush="Gray" BorderThickness="1" Margin="5" CornerRadius="5" Height="40" Width="200">
                <Button x:Name="CategoryButton" Click="CategoryButton_Click" Content="{Binding Name}" FontWeight="Bold" FontSize="14" Background="HotPink" BorderBrush="Transparent" BorderThickness="0"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!--<ListBox x:Name="ListBoxTest" DisplayMemberPath="Title" d:ItemsSource="{d:SampleData ItemCount=5}"/>-->
        <ItemsControl x:Name="CategoriesItemsControl" ItemTemplate="{StaticResource CategoryTemplate}" Margin="10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"></WrapPanel>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

    </Grid>
</UserControl>
