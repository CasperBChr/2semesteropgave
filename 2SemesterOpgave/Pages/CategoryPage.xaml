<UserControl x:Class="_2SemesterOpgave.Pages.CategoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2SemesterOpgave.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <DataTemplate x:Key="CategoryTemplate">
            <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="5">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <!--<Image Source="{Binding ImageUrl}" Width="100" Height="100" Margin="5"/>-->
                    <StackPanel Orientation="Vertical" Margin="5">
                        <Button Content="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!--<ListBox x:Name="ListBoxTest" DisplayMemberPath="Title" d:ItemsSource="{d:SampleData ItemCount=5}"/>-->
        <ItemsControl x:Name="CategoriesItemsControl" ItemTemplate="{StaticResource CategoryTemplate}" Margin="10"/>

    </Grid>
</UserControl>
