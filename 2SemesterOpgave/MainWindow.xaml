<Window x:Class="_2SemesterOpgave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2SemesterOpgave"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1200">
    <Window.Resources>
        <Style x:Key="TopBarAccountButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10, 5, 10, 10" />
            <Setter Property="Margin" Value="10, 5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10">
                            <Grid Height="50" Width="50">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#F2F2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBarIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10, 5, 10, 10" />
            <Setter Property="Margin" Value="10, 5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10">
                            <Grid Height="40" Width="40">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#F2F2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="VerticalMenuButton" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#1A000000"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <!--<Setter TargetName="RootBorder" Property="Background" Value="#33000000"/>-->
                                <!--<Setter Property="RenderTransform">-->
                                <!--<Setter.Value>
										<ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
									</Setter.Value>-->
                                <!--</Setter>-->
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>


                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!--<TextBlock Text="RentWear" Grid.Column="0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#222"/>-->
            <Button Style="{StaticResource VerticalMenuButton}" FontSize="16" FontWeight="Bold" Foreground="#222" Grid.Row="0" Grid.Column="0" Click="HomeMenuButton_Click">
                <Image Source="/Assets/Asset_1.png" Height="50" Width="83" />
            </Button>


            <Grid Grid.Column="1" Margin="10" MaxWidth="500">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBox Background="LightGray" BorderThickness="0" Padding="10,5" VerticalContentAlignment="Center" Foreground="#333" FontSize="13" Text="Søg..." />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="100"/>
                        <ColumnDefinition Width="auto" MinWidth="20"/>
                        <ColumnDefinition Width="*" MinWidth="100"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Name" Grid.Row="0" Grid.Column="0" Text="Kategori" SelectionChanged="CategoryCombo_SelectionChanged"/>

                    <ComboBox x:Name="SubcategoryCombo" DisplayMemberPath="Name" Grid.Row="0" Grid.Column="2" Text="Underkategori" SelectionChanged="SubcategoryComboBox_SelectionChanged" />
                </Grid>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid Margin="10, 5">
                    <Button Style="{StaticResource TopBarIconButton}" Click="MessagesButton_Click">
                        <TextBlock Text="💬"/>
                    </Button>
                    <Border x:Name="MessagesBadgeBorder" Visibility="Collapsed" Background="Red" Width="20" Height="20" CornerRadius="20" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="MessagesAmountTextBlock" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <Grid Margin="10, 5">
                    <Button Style="{StaticResource TopBarIconButton}" Click="NotificationsButton_Click">
                        <TextBlock Text="🔔"/>
                    </Button>
                    <Border Background="Red" Width="20" Height="20" CornerRadius="20" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="NotificationsAmountTextBlock" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <Grid Margin="10, 5">
                    <Button Style="{StaticResource TopBarIconButton}" Click="MyArticlePageButton_Click" Margin="10,5,10,5">
                        <TextBlock Text="+" FontSize="35"/>
                    </Button>
                </Grid>
                <Grid Margin="10, 5">
                    <Button Style="{StaticResource TopBarAccountButton}" Click="MyAccountButton_Click">
                        <Grid>
                            <!--<Ellipse Height="40" Width="40" Fill="LightGray"/>-->
                            <Border BorderBrush="Black" BorderThickness="1" Height="40" Width="40" CornerRadius="20">
                                <Image Source="/Assets/UserIconAsset.png" Width="30" Height="30" />
                            </Border>
                        </Grid>
                    </Button>
                </Grid>

            </StackPanel>

        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Grid Grid.Column="0" Grid.Row="1"  Background="AliceBlue">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--<Button Style="{StaticResource VerticalMenuButton}" Content="Hjem" Grid.Row="0" Grid.Column="0" Click="HomeMenuButtonClick"/-->
                <Button Style="{StaticResource VerticalMenuButton}" Content="Udforsk" Grid.Row="0" Grid.Column="0" Click="ExplorerMenuButton_Click"/>
				<Button Style="{StaticResource VerticalMenuButton}" Content="Kategorier" Grid.Row="1" Grid.Column="0" Click="CategoriMenuButton_Click"/>
                <Button Style="{StaticResource VerticalMenuButton}" Content="For You" Grid.Row="2" Grid.Column="0" Click="ForYouButton_Click"/>
				<Button Style="{StaticResource VerticalMenuButton}" Content="Favoritter" Grid.Row="3" Grid.Column="0" Click="FavoritPageButton_Click"/>
				<Line StrokeThickness="1" Stroke="Black"  Grid.Row="4" Grid.Column="0" />
				<Button Style="{StaticResource VerticalMenuButton}" Content="Udlej" Grid.Row="5" Grid.Column="0" Click="CreateArticleButton_Click"/>
                <Button Style="{StaticResource VerticalMenuButton}" Content="Mine ordrer" Grid.Row="6" Grid.Column="0"  Click="MyOrderButton_Click"/>
				<Button Style="{StaticResource VerticalMenuButton}" Content="Min konto" Grid.Row="7" Grid.Column="0" Click="MyAccountButton_Click"/>
			</Grid>
            <ContentControl Grid.Column="1" Grid.Row="0" x:Name="PageContentControl"/>
        </Grid>
    </Grid>
</Window>
