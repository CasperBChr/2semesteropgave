<Window x:Class="_2SemesterOpgave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2SemesterOpgave"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="AliceBlue">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Button Content="Hjem" Grid.Row="0" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Top" Click="HomeMenuButtonClick"/>
            <Button Content="Udforsk" Grid.Row="1" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Top" Click="ExplorerMenuButtonClick"/>
            <Button Content="Kategorier" Grid.Row="2" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Top" Click="CategoriMenuButtonClick"/>
            <Button Content="Nyheder" Grid.Row="3" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Top" Click="NewsPageButtonClick"/>
            <Button Content="Favoritter" Grid.Row="4" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Top" Click="FavoritPageButtonClick"/>
            <Button Content="Mine ordrer" Grid.Row="5" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Top" Click="MyOrderButtonClick"/>
            <Button Content="Min konto" Grid.Row="6" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Top" Click="MyAccountButtonClick"/>
            <Button Content="Beskeder" Grid.Row="7" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Top" Click="MessagesButtonClick"/>
            <Button Content="Hjælp" Grid.Row="8" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Top" Click="SupportButtonClick"/>
        

        </Grid>
        <ContentControl Grid.Column="1" Grid.Row="0" x:Name="PageContentControl"/>
    </Grid>
</Window>
